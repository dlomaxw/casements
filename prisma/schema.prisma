generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id              String       @id @default(cuid())
  fullName        String
  email           String?
  phone           String? // optional: general contact enquiries have no phone
  productCategory String // "general-enquiry" for contact-form messages
  projectSize     ProjectSize? // null for general contact enquiries
  timeline        String?
  message         String?
  sourcePage      String? // the URL the web form was submitted from (web leads only)

  // ---- Mandatory pipeline fields (see lib/pipeline.ts) -------------------
  // Every lead must always carry: source, owner, stage. While the lead is
  // open it must also carry a next action; to close it as LOST/DISQUALIFIED
  // it must carry a loss reason. The rules are enforced server-side in
  // lib/pipeline.ts — the UI only mirrors them.
  source       LeadSource @default(WEBSITE_FORM)
  sourceDetail String? // campaign, referrer name, exhibition — free text detail

  status LeadStatus @default(NEW) // the stage

  // Owner. Mandatory in the application layer (lib/pipeline.ts): no code path
  // may leave a lead unowned. Kept nullable in the database so the change is
  // purely additive and no existing row has to be rewritten to migrate.
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // Next action — mandatory while the lead is open.
  nextAction     String?
  nextActionDate DateTime?

  // Loss reason — mandatory when the stage is LOST or DISQUALIFIED.
  lossReason String? // LossReason value
  lossDetail String?

  // ---- Qualification (the structured first-contact check) ---------------
  // All five must be present before a lead may enter QUALIFIED.
  qualNeed      String? // what they actually want built
  qualLocation  String? // site location — rules out out-of-area work
  qualBudget    String? // BudgetBand value
  qualUrgency   String? // Urgency value
  qualDecision  String? // DecisionReadiness value
  qualifiedAt   DateTime?
  qualifiedById String?

  // ---- Money ------------------------------------------------------------
  // Deal value in UGX, so the pipeline can be reported in shillings and not
  // only in lead counts. quotationRef links out to the external quotation
  // system (favourwings) that actually produces the document.
  dealValue    BigInt? // UGX
  quotationRef String?
  quotationUrl String?
  quotedAt     DateTime?
  wonAt        DateTime?
  closedAt     DateTime? // WON, LOST or DISQUALIFIED — for cycle-time reporting

  // ---- Contact discipline / SLA -----------------------------------------
  lastContactedAt DateTime? // set whenever a contact attempt is logged
  firstResponseAt DateTime? // first contact attempt — drives the response-time SLA
  contactAttempts Int       @default(0)

  // Duplicate handling — a lead closed as DUPLICATE points at the original.
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Lead[]  @relation("LeadDuplicates")

  followUpDate DateTime? // legacy — superseded by nextActionDate
  notes        String?
  activities   Activity[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([nextActionDate])
  @@index([source])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String // STATUS_CHANGE | NOTE | EMAIL_SENT | CALL_LOGGED | CONTACT_ATTEMPT | QUALIFICATION
  note      String?
  // Structured outcome of a contact attempt (ContactOutcome value) — so
  // "called, no response" is a recorded fact, not a note someone forgot to type.
  outcome   String?
  // Who did it. Null for system-generated entries (form capture, auto-assign).
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  // Not in the original doc schema, but required for NextAuth credentials login
  passwordHash    String?
  whatsappNumber  String?
  title           String? // e.g. "Sales Director — Kampala HQ"
  role            Role            @default(SALES_REP)
  active          Boolean         @default(true)
  // Notification preferences (Settings dashboard)
  notifyEmail     Boolean         @default(true)
  notifyDesktop   Boolean         @default(false)
  notifyInventory Boolean         @default(false)
  leads           Lead[]
  productMap      RepProductMap[]
  posts           Post[]
  media           Media[]
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  body        String // markdown / plain text
  coverImage  String? // image URL
  videoUrl    String? // YouTube / Vimeo / other embed link
  category    String     @default("News")
  status      PostStatus @default(DRAFT)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
}

model Media {
  id           String   @id @default(cuid())
  url          String
  filename     String
  contentType  String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// Editable website content blocks (developer/marketing CMS).
// key mirrors lib/content.ts registry, e.g. "home.hero.title".
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Anonymous page-view analytics (self-hosted). No IPs stored — `visitor` is a
// daily-rotating salted hash so repeat views can be de-duplicated without PII.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitor   String
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// Project portfolio — managed from /crm/projects (replaces the hardcoded list).
model ProjectItem {
  id         String   @id @default(cuid())
  name       String
  location   String
  completion String // e.g. "December 2010"
  scope      String
  image      String
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// YouTube videos shown in the home-page showcase — managed from /crm/videos.
model HomeVideo {
  id        String   @id @default(cuid())
  title     String // caption shown under the player
  url       String // any YouTube watch / youtu.be / embed link
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Product catalogue — managed from /crm/products (replaces the hardcoded list).
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  shortTitle      String
  type            String   @default("Other") // material / category, e.g. "Aluminium"
  description     String // card / index blurb
  longDescription String // detail-page overview
  image           String // main image
  imageAlt        String?
  videoUrl        String? // YouTube / Vimeo link
  brochureUrl     String? // downloadable product brochure (PDF / Drive link)
  subItems        String[] // feature list
  gallery         Json? // [{ src, alt }]
  faqs            Json? // [{ question, answer }] — rendered on-page + FAQPage schema
  priceList       Json? // [{ group, note?, items: [{ label, price }] }] — published UGX price table
  keywords        String[]
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// §9.1 of the docs: assignLeadToRep looks up rep_product_map for the category
model RepProductMap {
  id       String @id @default(cuid())
  category String @unique // product slug, e.g. "aluminium-doors-and-windows"
  userId   String
  user     User   @relation(fields: [userId], references: [id])
}

enum LeadStatus {
  NEW // captured, nobody has spoken to them yet
  CONTACTED // reached (or attempted) — qualification not yet complete
  QUALIFIED // passed the first-contact check: real need, in area, budget, urgency
  SITE_ASSESSED // site visit / measurements done
  QUOTED // quotation issued
  WON // order placed
  LOST // was a genuine prospect, did not close
  DISQUALIFIED // never a genuine prospect: spam, out of area, duplicate, no need
}

// Where the lead actually came from. An enum, not free text, so the marketing
// spend can be measured per channel.
enum LeadSource {
  WEBSITE_FORM
  WEBSITE_CHAT
  PHONE_CALL
  WHATSAPP
  WALK_IN
  REFERRAL
  REPEAT_CLIENT
  FACEBOOK
  INSTAGRAM
  GOOGLE_ADS
  EXHIBITION
  OTHER
}

enum ProjectSize {
  SMALL
  MEDIUM
  LARGE
  COMMERCIAL
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
  MARKETING
  SALES_REP
}

enum PostStatus {
  DRAFT
  PUBLISHED
}
